# ===========================================
# LMS RAG Backend - Environment Configuration
# ===========================================

# Application Settings
APP_NAME="LMS RAG Backend"
APP_ENV=development
DEBUG=true
HOST=0.0.0.0
PORT=8000

# API Key Authentication
API_KEY=your-secure-api-key-here
API_KEY_HEADER=X-API-Key

# ===========================================
# LLM Configuration
# ===========================================

# Primary: Ollama (Local)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3:8b
# Alternative models: mistral:7b, phi3:mini

# Fallback: Cloud Providers (Optional)
# Groq
GROQ_API_KEY=your-groq-api-key
GROQ_MODEL=llama3-8b-8192

# Together AI
TOGETHER_API_KEY=your-together-api-key
TOGETHER_MODEL=meta-llama/Llama-3-8b-chat-hf

# Cloud Fallback Toggle
USE_CLOUD_FALLBACK=true
CLOUD_PROVIDER=groq  # groq or together

# ===========================================
# Vector Database (ChromaDB)
# ===========================================
CHROMA_PERSIST_DIRECTORY=./data/chroma_db
CHROMA_COLLECTION_NAME=lms_documents

# ===========================================
# Embeddings Configuration
# ===========================================
EMBEDDING_MODEL=BAAI/bge-large-en-v1.5
# Alternative: BAAI/bge-base-en-v1.5 (lighter)
# Future: BAAI/bge-m3 (multilingual)

# ===========================================
# Document Processing
# ===========================================
UPLOAD_DIRECTORY=./data/uploads
MAX_UPLOAD_SIZE_MB=50
ALLOWED_EXTENSIONS=pdf,txt,html,csv,png,jpg,jpeg

# Chunking Configuration
CHUNK_SIZE=1000
CHUNK_OVERLAP=200

# ===========================================
# RAG Configuration
# ===========================================
TOP_K_RESULTS=5
SIMILARITY_THRESHOLD=0.7

# ===========================================
# Logging
# ===========================================
LOG_LEVEL=INFO
LOG_FORMAT=%(asctime)s - %(name)s - %(levelname)s - %(message)s
